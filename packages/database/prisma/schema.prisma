datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  admin
  customer
}

enum VehicleType {
  mobil
  motor
}

enum BookingStatus {
  menunggu
  dikonfirmasi
  diproses
  selesai
  dibatalkan
}

enum PhotoStage {
  checkin
  checkout
}

enum NotificationChannel {
  push
  whatsapp
  email
}

enum PaymentType {
  dp
  pelunasan
}

enum PaymentMethod {
  tunai
  transfer
  kartu
  ewallet
}

enum PaymentStatus {
  pending
  paid
  failed
}

model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  auth_user_id String   @unique @db.Uuid
  full_name    String
  phone        String
  email        String
  role         UserRole @default(customer)
  avatar_url   String?
  created_at   DateTime @default(now())

  vehicles              Vehicle[]
  bookings              Booking[]
  status_changes        BookingStatusHistory[]
  notifications         Notification[]
  support_conversations SupportConversation[]
  stock_movements       StockMovement[]
  payments_recorded     Payment[]
  promo_redemptions     PromoRedemption[]

  @@map("profiles")
}

model Vehicle {
  id               String      @id @default(uuid()) @db.Uuid
  owner_id         String      @db.Uuid
  plate_number     String
  brand            String
  model            String
  year             Int
  vehicle_type     VehicleType
  last_odometer_km Int         @default(0)
  created_at       DateTime    @default(now())

  owner    Profile   @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([owner_id, plate_number])
  @@map("vehicles")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  duration_minutes Int
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())

  booking_services BookingService[]
  service_items    ServiceItem[]

  @@map("services")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  customer_id     String        @db.Uuid
  vehicle_id      String        @db.Uuid
  mechanic_id     String?       @db.Uuid
  branch_id       String?       @db.Uuid
  scheduled_at    DateTime
  status          BookingStatus @default(menunggu)
  complaint_notes String?
  estimated_cost  Decimal       @default(0) @db.Decimal(12, 2)
  final_cost      Decimal?      @db.Decimal(12, 2)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  customer         Profile                 @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  vehicle          Vehicle                 @relation(fields: [vehicle_id], references: [id], onDelete: Restrict)
  mechanic         Mechanic?               @relation(fields: [mechanic_id], references: [id], onDelete: SetNull)
  branch           Branch?                 @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  booking_services BookingService[]
  status_history   BookingStatusHistory[]
  photos           VehicleConditionPhoto[]
  review           Review?
  payments         Payment[]
  promo_redemption PromoRedemption?

  @@unique([mechanic_id, scheduled_at])
  @@index([scheduled_at])
  @@index([status])
  @@map("bookings")
}

model BookingService {
  id               String  @id @default(uuid()) @db.Uuid
  booking_id       String  @db.Uuid
  service_id       String  @db.Uuid
  price_at_booking Decimal @db.Decimal(12, 2)

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  service Service @relation(fields: [service_id], references: [id], onDelete: Restrict)

  @@unique([booking_id, service_id])
  @@map("booking_services")
}

model BookingStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  booking_id String        @db.Uuid
  status     BookingStatus
  changed_by String        @db.Uuid
  note       String?
  changed_at DateTime      @default(now())

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  changer Profile @relation(fields: [changed_by], references: [id], onDelete: Restrict) // audit trail: profil pengubah tidak boleh menghapus riwayat

  @@map("booking_status_history")
}

model Branch {
  id                String @id @default(uuid()) @db.Uuid
  name              String
  address           String
  phone             String
  capacity_per_slot Int    @default(2)

  mechanics Mechanic[]
  bookings  Booking[]

  @@map("branches")
}

model Mechanic {
  id        String  @id @default(uuid()) @db.Uuid
  branch_id String  @db.Uuid
  full_name String
  specialty String
  is_active Boolean @default(true)

  branch   Branch    @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("mechanics")
}

model VehicleConditionPhoto {
  id          String     @id @default(uuid()) @db.Uuid
  booking_id  String     @db.Uuid
  photo_url   String
  stage       PhotoStage
  caption     String?
  uploaded_at DateTime   @default(now())

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("vehicle_condition_photos")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  booking_id String   @unique @db.Uuid
  rating     Int
  comment    String?
  created_at DateTime @default(now())

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  user_id      String              @db.Uuid
  title        String
  body         String
  is_read      Boolean             @default(false)
  sent_channel NotificationChannel
  created_at   DateTime            @default(now())

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  booking_id   String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  payment_type PaymentType
  method       PaymentMethod @default(tunai) // cara bayar; dicatat admin di kasir
  status       PaymentStatus @default(pending)
  midtrans_ref String? // referensi transfer / gateway, diisi manual bila ada
  note         String?
  paid_at      DateTime?
  recorded_by  String?       @db.Uuid // admin yang mencatat pembayaran ini
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  booking  Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  recorder Profile? @relation(fields: [recorded_by], references: [id], onDelete: SetNull)

  @@index([booking_id])
  @@index([status, paid_at])
  @@map("payments")
}

// ── Live CS (PLAN.md #2) ─────────────────────────────────────────────
// Tabel, trigger, RLS, dan realtime dibuat oleh supabase/support_chat.sql.
// Model di sini supaya Prisma mengenal tabelnya (prisma db push tidak menganggapnya drift).
// Klien membaca/menulis langsung lewat Supabase (RLS), bukan lewat API Prisma.
model SupportConversation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // browser insert tanpa id: default harus di DB
  customer_id        String   @db.Uuid
  customer_name      String   @default("")
  customer_email     String   @default("")
  status             String   @default("active")
  last_message       String?
  last_message_at    DateTime @default(now()) @db.Timestamptz(6)
  unread_admin_count Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  customer Profile          @relation(fields: [customer_id], references: [auth_user_id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([customer_id], map: "support_conversations_customer_idx")
  @@index([last_message_at(sort: Desc)], map: "support_conversations_last_msg_idx")
  @@map("support_conversations")
}

model SupportMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String   @db.Uuid
  sender_type     String
  sender_id       String?  @db.Uuid
  message         String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  conversation SupportConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at], map: "support_messages_conversation_idx")
  @@map("support_messages")
}

// ── Stok barang bengkel ──────────────────────────────────────────────
// Layanan membutuhkan barang (oli, filter, kampas rem). Kalau stok barangnya habis,
// layanan yang memakainya tidak bisa dikerjakan: dashboard admin memberi peringatan
// supaya layanan itu dinonaktifkan dari katalog.

enum StockMovementType {
  masuk // barang datang / restock
  keluar // terpakai untuk servis
  penyesuaian // koreksi hasil stok opname
}

model InventoryItem {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  sku        String?  @unique
  unit       String   @default("pcs") // satuan: pcs, liter, botol, set
  stock_qty  Int      @default(0)
  min_qty    Int      @default(0) // ambang "menipis"; di bawah ini admin diingatkan
  price      Decimal? @db.Decimal(12, 2) // harga beli per satuan, untuk nilai stok
  note       String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  service_items ServiceItem[]
  movements     StockMovement[]

  @@index([name])
  @@map("inventory_items")
}

/// Barang yang dipakai sebuah layanan, beserta jumlah pemakaian per servis.
model ServiceItem {
  id         String   @id @default(uuid()) @db.Uuid
  service_id String   @db.Uuid
  item_id    String   @db.Uuid
  qty_needed Int      @default(1)
  created_at DateTime @default(now())

  service Service       @relation(fields: [service_id], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([service_id, item_id])
  @@index([item_id])
  @@map("service_items")
}

/// Riwayat pergerakan stok: satu baris per penambahan, pemakaian, atau koreksi.
model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  item_id     String            @db.Uuid
  type        StockMovementType
  quantity    Int // selalu positif; arah ditentukan oleh `type`
  stock_after Int
  note        String?
  changed_by  String?           @db.Uuid
  created_at  DateTime          @default(now())

  item    InventoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  changer Profile?      @relation(fields: [changed_by], references: [id], onDelete: SetNull)

  @@index([item_id, created_at])
  @@map("stock_movements")
}

// ── Voucher / kode promo ─────────────────────────────────────────────
// Dulu daftarnya ditulis langsung di packages/shared/src/promos.ts. Sekarang disimpan di
// database supaya admin bisa menambah, membatasi kuota, dan menonaktifkan voucher sendiri.

enum PromoDiscountType {
  persen // discount_value dibaca sebagai persen (1-100)
  nominal // discount_value dibaca sebagai rupiah
}

model Promo {
  id                 String            @id @default(uuid()) @db.Uuid
  code               String            @unique // selalu disimpan huruf besar
  title              String
  description        String?
  badge              String?
  discount_type      PromoDiscountType @default(persen)
  discount_value     Decimal           @db.Decimal(12, 2)
  max_discount       Decimal?          @db.Decimal(12, 2) // batas potongan untuk tipe persen
  min_spend          Decimal?          @db.Decimal(12, 2) // minimal estimasi biaya layanan
  quota              Int? // total pemakaian; kosong = tanpa batas
  used_count         Int               @default(0)
  per_customer_limit Int? // batas pemakaian per pelanggan; kosong = bebas
  valid_from         DateTime?
  valid_until        DateTime?
  is_active          Boolean           @default(true)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  redemptions PromoRedemption[]

  @@index([is_active, valid_until])
  @@map("promos")
}

/// Satu baris per pemakaian voucher pada sebuah booking (dipakai untuk kuota & laporan).
model PromoRedemption {
  id              String   @id @default(uuid()) @db.Uuid
  promo_id        String   @db.Uuid
  booking_id      String   @unique @db.Uuid
  customer_id     String   @db.Uuid
  discount_amount Decimal  @db.Decimal(12, 2)
  created_at      DateTime @default(now())

  promo    Promo   @relation(fields: [promo_id], references: [id], onDelete: Cascade)
  booking  Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  customer Profile @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([promo_id, customer_id])
  @@map("promo_redemptions")
}

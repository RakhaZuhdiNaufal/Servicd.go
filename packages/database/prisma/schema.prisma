datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  admin
  customer
}

enum VehicleType {
  mobil
  motor
}

enum BookingStatus {
  menunggu
  diproses
  selesai
  dibatalkan
}

enum PhotoStage {
  checkin
  checkout
}

enum NotificationChannel {
  push
  whatsapp
  email
}

enum PaymentType {
  dp
  pelunasan
}

enum PaymentStatus {
  pending
  paid
  failed
}

model Profile {
  id           String      @id @default(uuid()) @db.Uuid
  auth_user_id String      @unique @db.Uuid
  full_name    String
  phone        String
  email        String
  role         UserRole    @default(customer)
  avatar_url   String?
  created_at   DateTime    @default(now())

  vehicles       Vehicle[]
  bookings       Booking[]
  status_changes BookingStatusHistory[]
  notifications  Notification[]

  @@map("profiles")
}

model Vehicle {
  id               String      @id @default(uuid()) @db.Uuid
  owner_id         String      @db.Uuid
  plate_number     String      @unique
  brand            String
  model            String
  year             Int
  vehicle_type     VehicleType
  last_odometer_km Int         @default(0)
  created_at       DateTime    @default(now())

  owner    Profile   @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("vehicles")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  duration_minutes Int
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())

  booking_services BookingService[]

  @@map("services")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  customer_id     String        @db.Uuid
  vehicle_id      String        @db.Uuid
  mechanic_id     String?       @db.Uuid
  branch_id       String?       @db.Uuid
  scheduled_at    DateTime
  status          BookingStatus @default(menunggu)
  complaint_notes String?
  estimated_cost  Decimal       @default(0) @db.Decimal(12, 2)
  final_cost      Decimal?      @db.Decimal(12, 2)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  customer         Profile                  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  vehicle          Vehicle                  @relation(fields: [vehicle_id], references: [id], onDelete: Restrict)
  mechanic         Mechanic?                @relation(fields: [mechanic_id], references: [id], onDelete: SetNull)
  branch           Branch?                  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  booking_services BookingService[]
  status_history   BookingStatusHistory[]
  photos           VehicleConditionPhoto[]
  review           Review?
  payments         Payment[]

  @@unique([mechanic_id, scheduled_at])
  @@index([scheduled_at])
  @@index([status])
  @@map("bookings")
}

model BookingService {
  id               String   @id @default(uuid()) @db.Uuid
  booking_id       String   @db.Uuid
  service_id       String   @db.Uuid
  price_at_booking Decimal  @db.Decimal(12, 2)

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  service Service @relation(fields: [service_id], references: [id], onDelete: Restrict)

  @@unique([booking_id, service_id])
  @@map("booking_services")
}

model BookingStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  booking_id String        @db.Uuid
  status     BookingStatus
  changed_by String        @db.Uuid
  note       String?
  changed_at DateTime      @default(now())

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  changer Profile @relation(fields: [changed_by], references: [id], onDelete: Cascade)

  @@map("booking_status_history")
}

model Branch {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  address           String
  phone             String
  capacity_per_slot Int      @default(2)

  mechanics Mechanic[]
  bookings  Booking[]

  @@map("branches")
}

model Mechanic {
  id        String  @id @default(uuid()) @db.Uuid
  branch_id String  @db.Uuid
  full_name String
  specialty String
  is_active Boolean @default(true)

  branch   Branch    @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("mechanics")
}

model VehicleConditionPhoto {
  id          String     @id @default(uuid()) @db.Uuid
  booking_id  String     @db.Uuid
  photo_url   String
  stage       PhotoStage
  caption     String?
  uploaded_at DateTime   @default(now())

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("vehicle_condition_photos")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  booking_id String   @unique @db.Uuid
  rating     Int
  comment    String?
  created_at DateTime @default(now())

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  user_id      String              @db.Uuid
  title        String
  body         String
  is_read      Boolean             @default(false)
  sent_channel NotificationChannel
  created_at   DateTime            @default(now())

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  booking_id   String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  payment_type PaymentType
  status       PaymentStatus @default(pending)
  midtrans_ref String?
  paid_at      DateTime?

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

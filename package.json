{
  "name": "servicego",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "prisma:generate": "pnpm --filter @servicego/database prisma generate",
    "prisma:migrate": "pnpm --filter @servicego/database prisma migrate dev",
    "prisma:seed": "pnpm --filter @servicego/database prisma db seed",
    "prisma:studio": "pnpm --filter @servicego/database prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.21.0"
}
